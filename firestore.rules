rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dailyReports/{reportId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /misloadIncidents/{incidentId} {
      allow read, write: if true;
    }
  }
}
